# Set exactly one tool. There is no default.
tool: cursor
# Profiles live in harness/models.yaml (default | offline | hybrid-local | cheap).
# hybrid-local: Ollama for review roles + keep implementers on the host tool.
profile: default
confirmProfile: true

# Hooks default on in harness.yaml defaults. Override here only if you must disable.
# failClosed applies to beforeShell (and optional beforeMCP) when true.
hooks:
  enable: true
  failClosed: false

# Demo-repo only: bounded contexts for the diff-scope sensor, and the loop PRD.
# Keep these out of harness.yaml so the shared file stays portable.
contexts:
  - examples/two-services/services/orders
  - examples/two-services/services/billing

loop:
  prd: specs/example-idempotent-consumers/PRD.md
  maxTurns: 20
  maxSeconds: 1800
  maxCostUsd: 5.0

# Working on this harness repo: drop harness/** or every loop unit that
# touches the harness ends needs-human. Arrays replace, they do not append.
# A consuming repo should keep the shared default, which includes harness/**.
# review:
#   humanRequired:
#     paths:
#       - '**/auth/**'
#       - '**/payments/**'
#       - '**/migrations/**'
#       - 'infra/**'
#       - 'terraform/**'
#       - '.github/workflows/**'

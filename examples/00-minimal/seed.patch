-[[ -z "$payload" ]] && payload="{}"
-root="${VERIFY_ROOT:-$HARNESS_ROOT}"
-harness_config_load "$HARNESS_ROOT"
-
-state_file="$root/.harness/loop-state.json"
-mkdir -p "$root/.harness"
-
-session_id="$(jq -r '.session_id // .sessionId // "local"' <<<"$payload")"

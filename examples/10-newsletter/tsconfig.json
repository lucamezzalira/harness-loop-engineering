{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "composite": true,
    "incremental": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["packages/**/*.ts", "services/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}

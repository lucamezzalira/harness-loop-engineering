{
  "name": "two-services-example",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "two-services-example",
      "workspaces": [
        "packages/*",
        "services/*"
      ]
    },
    "node_modules/@acme/billing": {
      "resolved": "services/billing",
      "link": true
    },
    "node_modules/@acme/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@acme/orders": {
      "resolved": "services/orders",
      "link": true
    },
    "packages/contracts": {
      "name": "@acme/contracts",
      "version": "1.0.0"
    },
    "services/billing": {
      "name": "@acme/billing",
      "version": "1.0.0",
      "dependencies": {
        "@acme/contracts": "1.0.0"
      }
    },
    "services/orders": {
      "name": "@acme/orders",
      "version": "1.0.0",
      "dependencies": {
        "@acme/contracts": "1.0.0"
      }
    }
  }
}

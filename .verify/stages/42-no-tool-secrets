#!/usr/bin/env bash
# no-tool-secrets: fail when rendered tool config looks like it embeds credentials.
set -euo pipefail
command -v python3 >/dev/null || exit 2
root="${VERIFY_ROOT:-$PWD}"
root="$(cd "$root" && pwd)"

python3 - "$root" <<'PY'
import json, os, re, sys

root = sys.argv[1]
deny_keys = {"token", "secret", "apikey", "api_key", "password", "authorization", "private_key", "privatekey"}
deny_vals = re.compile(
    r"(?i)(sk-[a-z0-9]{16,}|ghp_[a-z0-9]{20,}|xox[baprs]-[a-z0-9-]{20,}|bearer\s+[a-z0-9\._\-]{20,})"
)

candidates = [".cursor/mcp.json", ".mcp.json", "shared-tools/mcp.yaml"]
fail = 0

def walk(obj, path=""):
    global fail
    if isinstance(obj, dict):
        for k, v in obj.items():
            key_norm = re.sub(r"[^a-z0-9]", "", k.lower())
            here = f"{path}.{k}" if path else k
            if key_norm in deny_keys and v not in (None, "", []):
                print(f"no-tool-secrets: deny-listed key {here}")
                fail = 1
            walk(v, here)
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            walk(v, f"{path}[{i}]")
    elif isinstance(obj, str):
        if deny_vals.search(obj):
            print(f"no-tool-secrets: credential-like value at {path}")
            fail = 1
        if re.search(r"(?i)\.env|process\.env|getenv\(", obj):
            print(f"no-tool-secrets: env reference at {path}")
            fail = 1

for rel in candidates:
    path = os.path.join(root, rel)
    if not os.path.isfile(path):
        continue
    text = open(path, encoding="utf-8").read()
    if deny_vals.search(text):
        print(f"no-tool-secrets: credential-like value in {rel}")
        fail = 1
    if rel.endswith(".json"):
        try:
            walk(json.loads(text))
        except json.JSONDecodeError as e:
            print(f"no-tool-secrets: invalid JSON {rel}: {e}")
            fail = 1
    else:
        if re.search(r"(?i)(token|secret|api[_-]?key|password)\s*:", text):
            print(f"no-tool-secrets: deny-listed key in {rel}")
            fail = 1

sys.exit(fail)
PY

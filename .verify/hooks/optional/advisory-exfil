#!/usr/bin/env bash
# optional/advisory-exfil: Cursor-only advisory prompt hook.
# Evaluates whether a shell command looks like it is moving data off the machine.
# Advisory: never blocks. Exists to show the mechanism and when a model may
# participate (produce a note) without deciding pass or fail.
set -euo pipefail

payload="$(cat || true)"
[[ -z "$payload" ]] && payload="{}"

command_str="$(jq -r '
  .tool_input.command // .toolInput.command // .command // empty
' <<<"$payload")"

if [[ -z "$command_str" ]]; then
  exit 0
fi

# Heuristic only. Never deny.
if echo "$command_str" | grep -Eiq '(curl|wget|scp|rsync|nc |netcat).*(http|ftp|@[0-9]|:[0-9]{2,5})'; then
  echo "advisory: shell command may move data off the machine: ${command_str}" >&2
fi
exit 0
